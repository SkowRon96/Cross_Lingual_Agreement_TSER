# ============================================================
# Cross-Lingual Agreement (TSER) — repository ignore rules
# ============================================================

# ----- Large assets excluded from the repo (see instruction §7) -----
# Datasets (nEMO, CAMEO, ... — cloned HF repos with their own .git + LFS)
/datasets/
# Model weights (own models extracted from old_projects + downloaded checkpoints)
/models/
# Legacy projects (read-only source material; must never be modified by us)
/old_projects/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-tf/
venv/
env/
.python-version
.ipynb_checkpoints/

# ----- Caches -----
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/
# Hugging Face / torch caches if ever placed inside the project
.hf_cache/
.torch_cache/
# speechbrain / HF pretrained caches created at runtime in the repo root
wav2vec2_checkpoints/
pretrained_models/

# ----- OS -----
.DS_Store
Thumbs.db

# ----- IDE / tooling -----
.claude/settings.local.json
.vscode/*
# ...but keep the shared debug configurations (instruction §4: launch mainly in VS Code debug)
!.vscode/launch.json
!.vscode/settings.json

# ----- Results: track structure and final article-ready artifacts,
#       ignore heavy raw intermediates (add explicit patterns as they appear) -----
results/**/*.npz
results/**/*.pkl
results/**/tmp/
# Derived, machine-specific intermediates (regenerable via ingest/predict)
results/index/
results/predictions/
results/analysis/
# Transferred Qwen prediction dumps (large, regenerable on the GPU box)
scripts/qwen_windows/*.parquet
# Regenerable report artefacts (produced by scripts from cached predictions)
results/figures/
results/tables/

__article_results/
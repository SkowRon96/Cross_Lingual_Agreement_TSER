# ============================================================
# Cross-Lingual Agreement (TSER) — repository ignore rules
# ============================================================

# ----- Large assets excluded from the repo by design -----
# Datasets (nEMO, CAMEO, RAVDESS, MELD — see the README for how to obtain them)
/datasets/
# Downloaded model checkpoints and the Hugging Face cache (models/hf_cache)
/models/
# Legacy projects kept outside version control.
/old_projects/
# Trained weights of the author's own models (available on request; see the README)
/weights/

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-tf/
venv/
env/
.python-version
.ipynb_checkpoints/

# ----- Caches -----
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/
# Hugging Face / torch caches if ever placed inside the project
.hf_cache/
.torch_cache/
# speechbrain / HF pretrained caches created at runtime in the repo root
wav2vec2_checkpoints/
pretrained_models/

# ----- OS -----
.DS_Store
Thumbs.db

# ----- IDE / tooling -----
.vscode/*
# ...but keep the shared debug configurations
!.vscode/launch.json
!.vscode/settings.json

# ----- Author's working material (not part of the released code) -----
/instructions/
/disertation_descriptions/
/main.py
scripts/import_roberta_audit.py
# Merged into the README; kept locally as working copies.
/docs/
README copy.md

# ----- Results: never versioned; keep only the output directory itself.
#       Everything under results/ is regenerable with ingest/predict/analyze/report.
/results/*
!/results/.gitkeep
# Transferred Qwen prediction dumps (large, regenerable on the GPU box)
scripts/qwen_windows/*.parquet

__article_results/
